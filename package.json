{
  "name": "agent-intercom",
  "version": "2.0.0",
  "private": true,
  "description": "Local messaging and live groups for coding-agent sessions.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": { "node": ">=24" },
  "repository": { "type": "git", "url": "https://github.com/982945902/agent-intercom.git" },
  "bin": { "intercom": "./dist/apps/cli/index.js" },
  "exports": {
    ".": { "types": "./dist/packages/sdk/index.d.ts", "default": "./dist/packages/sdk/index.js" },
    "./node": { "types": "./dist/packages/sdk/node.d.ts", "default": "./dist/packages/sdk/node.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config apps/dashboard/vite.config.ts",
    "start": "node dist/apps/daemon/index.js",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "5.9.3",
    "vite": "^7.3.0"
  }
}
